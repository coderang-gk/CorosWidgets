# COROS Training Hub Credentials (Required)
COROS_EMAIL=your_coros_email@example.com
COROS_PASSWORD=your_coros_password
COROS_REGION=teamapi.coros.com

# Target Race & Training Plan Settings (Optional — customize for your goal race)
RACE_NAME=PUNE HALF MARATHON
RACE_DATE=2026-12-13
PLAN_START_DATE=2026-10-05
TOTAL_PLAN_WEEKS=10
GOAL_TIME=1:45:00
GOAL_PACE=4:58 /km
GOAL_PACE_SEC=298

# Optional AI / LLM Run Coach Upgrade (100% Optional — NO paid subscription needed!)
# By default, widget_server.py uses its built-in COROS EvoLab Physiological Rule Engine ($0 cost, no API key required).
# If you want generative LLM post-run coaching, paste a FREE Google AI Studio key (https://aistudio.google.com/apikey)
# or an OpenAI API key below. Results are cached per run so each run is only analyzed once.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Calendar Training Plan Sync (Optional — place credentials.json & token.json in backend/)
GCAL_CALENDAR_NAME=Pune Half Marathon 2026 Training
GCAL_CREDENTIALS_PATH=credentials.json
GCAL_TOKEN_PATH=token.json

# Server Port
WIDGET_SERVER_PORT=8095
